# diet_suggestion — environment variables
# Source of truth: src/config/env.ts. Copy to .env and fill real values.
# REQUIRED = server refuses to boot without it. Never commit the real .env.

PORT=4000                                  # OPTIONAL — HTTP port (default: 4000)
NODE_ENV=development                       # OPTIONAL — development | production | test (default: development)
DATABASE_URL=postgresql://user:pass@localhost:5432/diet    # REQUIRED — Postgres connection string
JWT_SECRET=change_me_at_least_16_chars_long                # REQUIRED — JWT signing secret (min 16 chars)
JWT_ACCESS_EXPIRES_IN=15m                  # OPTIONAL — access token lifetime (default: 15m)
JWT_REFRESH_EXPIRES_IN=7d                  # OPTIONAL — refresh token lifetime (default: 7d)
ALLOWED_ORIGINS=http://localhost:3000      # OPTIONAL — comma-separated CORS origins (default: http://localhost:3000)
