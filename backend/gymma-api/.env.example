# backend/gymma-api — environment variables
# Source of truth: src/config/env.ts. Copy to .env and fill real values.
# REQUIRED = server refuses to boot without it. Never commit the real .env.

# --- Core ---
NODE_ENV=development                       # OPTIONAL — development | test | production (default: development)
PORT=3001                                  # OPTIONAL — HTTP port (default: 3001)
FRONTEND_ORIGIN=http://localhost:3000      # OPTIONAL — must be a valid URL (default: http://localhost:3000). NOTE: not currently used by CORS (app.ts reflects any origin)

# --- Data stores ---
DATABASE_URL=postgresql://user:pass@localhost:5432/gymma   # REQUIRED — Postgres (PostGIS) connection string
REDIS_URL=redis://localhost:6379                           # REQUIRED — Redis connection string

# --- Auth / JWT ---
ACCESS_TOKEN_SECRET=change_me_min_1_char_but_use_32+       # REQUIRED — HS256 access-token secret (schema min 1; use 32+ random chars)
REFRESH_TOKEN_SECRET=change_me_at_least_16_chars_long      # REQUIRED — refresh-token secret (min 16 chars)
ACCESS_TOKEN_TTL=900                       # OPTIONAL — access token lifetime, seconds. ⚠️ code default is 2592000 (30 DAYS) — UNSAFE. Use ~900 (15 min).
REFRESH_TOKEN_TTL=2592000                  # OPTIONAL — refresh token lifetime, seconds (default: 2592000 = 30 days)

# --- Google Sign-In (owner/admin) ---
GOOGLE_CLIENT_ID=                          # OPTIONAL — Google OAuth client ID; empty disables Google login

# --- Object storage (owner gallery uploads, S3-compatible) ---
STORAGE_BUCKET=                            # OPTIONAL — bucket name; empty disables uploads (503 on upload)
STORAGE_ENDPOINT=                          # OPTIONAL — S3-compatible endpoint URL
STORAGE_ACCESS_KEY_ID=                     # OPTIONAL — storage access key
STORAGE_SECRET_ACCESS_KEY=                 # OPTIONAL — storage secret key
STORAGE_PUBLIC_URL=                        # OPTIONAL — public base URL images are served from

# --- Email (Resend) ---
RESEND_API_KEY=                            # OPTIONAL — Resend API key; empty disables outbound email
EMAIL_FROM=noreply@gymma.in                # OPTIONAL — from-address for transactional email (default: noreply@gymma.in)
