# fitos/backend — environment variables
# Source of truth: src/config/configuration.ts (+ process.env usage in src/).
# REQUIRED = app misbehaves/won't connect without it. Never commit the real .env.

PORT=3000                                  # OPTIONAL — HTTP port (default: 3000)
NODE_ENV=development                       # OPTIONAL — development | production (default: development)

# --- Data stores ---
DATABASE_URL=postgresql://user:pass@localhost:5432/fitos   # REQUIRED — Postgres connection string (no default; DB access fails without it)
REDIS_URL=redis://localhost:6379           # OPTIONAL — full Redis URL; if unset, REDIS_HOST/REDIS_PORT are used
REDIS_HOST=localhost                       # OPTIONAL — Redis host (default: localhost)
REDIS_PORT=6379                            # OPTIONAL — Redis port (default: 6379)

# --- Auth / JWT ---
ACCESS_TOKEN_SECRET=change_me_use_32+_random_chars         # REQUIRED — ⚠️ code falls back to a hardcoded 'dev_access_secret_change_me_...' default — UNSAFE in prod. Always set this.
JWT_ACCESS_EXPIRES_IN=15m                  # OPTIONAL — access token lifetime (default: 15m)
JWT_REFRESH_EXPIRES_IN=7d                  # OPTIONAL — refresh token lifetime (default: 7d)

# --- CORS ---
CORS_ORIGIN=http://localhost:3000          # OPTIONAL — allowed origin(s) for cross-origin requests

# NOTE: backend/keys/private.key + public.key are committed in the repo and should be
# treated as compromised — regenerate the keypair and keep private.key OUT of git.
