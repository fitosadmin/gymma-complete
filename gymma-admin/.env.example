# gymma-admin (Next.js admin) — environment variables
# Only NEXT_PUBLIC_* vars are read (exposed to the browser — never put secrets here).
# Copy to .env.local and fill real values.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1   # REQUIRED — gymma-api base URL. ⚠️ code falls back to a hardcoded https://gymma-api.onrender.com (lib/api.ts); set explicitly per environment.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com   # REQUIRED — Google OAuth client ID for admin sign-in.
