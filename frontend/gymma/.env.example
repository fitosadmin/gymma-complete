# frontend/gymma (Next.js consumer site) — environment variables
# Only NEXT_PUBLIC_* vars are read (they are exposed to the browser — never put secrets here).
# Copy to .env.local and fill real values.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1   # REQUIRED — gymma-api base URL. ⚠️ code silently falls back to localhost (api.ts) and an inconsistent :8085 (demo-form.tsx); always set explicitly in prod.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com   # REQUIRED for owner login — Google OAuth client ID. ⚠️ owner/login/page.tsx hardcodes a real prod client-id fallback; override it here.
