# broadcast-api — environment variables
# Source of truth: src/config/env.ts. Copy to .env and fill real values.
# REQUIRED = server refuses to boot without it. Never commit the real .env.

# --- Core ---
NODE_ENV=development                       # OPTIONAL — development | test | production (default: development)
PORT=3002                                  # OPTIONAL — HTTP API port (default: 3002)
WS_PORT=3001                               # OPTIONAL — WebSocket server port (default: 3001)
FRONTEND_ORIGIN=http://localhost:3000      # OPTIONAL — allowed origin (default: http://localhost:3000). NOTE: not enforced by CORS today

# --- Data stores ---
DATABASE_URL=postgresql://user:pass@localhost:5432/gymma   # REQUIRED — Postgres connection string
REDIS_URL=redis://localhost:6379                           # REQUIRED — Redis (general/cache) connection string
BULLMQ_REDIS_URL=redis://localhost:6379                    # REQUIRED — Redis used by BullMQ job queues

# --- Auth ---
ACCESS_TOKEN_SECRET=change_me_at_least_16_chars_long       # REQUIRED — must match gymma-api's ACCESS_TOKEN_SECRET (min 16); verifies incoming JWTs

# --- Firebase Cloud Messaging (push) ---
FCM_PROJECT_ID=                            # OPTIONAL — FCM project id; empty disables push
FCM_CLIENT_EMAIL=                          # OPTIONAL — FCM service-account email
FCM_PRIVATE_KEY=                           # OPTIONAL — FCM service-account private key (keep as one line with \n escapes)
FCM_SERVER_KEY=                            # OPTIONAL — legacy FCM server key

# --- Throughput limits ---
API_RATE_LIMIT_BROADCASTS_PER_HOUR=10      # OPTIONAL — max broadcasts per sender per hour (default: 10)
MAX_BROADCAST_BATCH_SIZE=1000              # OPTIONAL — max recipients per broadcast (default: 1000)
MAX_PUSH_BATCH_SIZE=500                    # OPTIONAL — max push messages per batch (default: 500)
MAX_WS_CONNECTIONS_PER_USER=3              # OPTIONAL — max concurrent sockets per user (default: 3)
